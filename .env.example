# Copy to .env and fill in. Never commit your real .env.

# Bot Access Token from developer.webex.com (your "Competitors News" bot)
WEBEX_BOT_TOKEN=your-webex-bot-access-token

# Anthropic API key for the analyst engine (the skill brain + web search)
ANTHROPIC_API_KEY=sk-ant-...

# Optional: shared secret so app.py verifies Webex's X-Spark-Signature.
# If set here, pass the SAME value when running setup_webhook.py.
WEBEX_WEBHOOK_SECRET=

# Optional model + budget tuning
# claude-sonnet-4-6 (fast/cheap, default) | claude-opus-4-8 (strongest)
ANTHROPIC_MODEL=claude-sonnet-4-6
MAX_WEB_SEARCHES=12
MAX_TOKENS=8000

# Local dev port
PORT=5000
